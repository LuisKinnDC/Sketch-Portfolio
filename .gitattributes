# Normaliza los finales de línea: LF en el repositorio, nativos en tu disco.
# Sin esto, Windows guarda CRLF y cada archivo aparecería como modificado
# entero al clonarlo desde otro sistema.
* text=auto eol=lf

# Binarios: que Git no intente tocarlos.
*.jpg binary
*.jpeg binary
*.png binary
*.webp binary
*.woff binary
*.woff2 binary
*.pdf binary
